# Copy to .env (gitignored) and fill in one key. Nothing else needs installing.
#
# Groq (OpenAI-compatible, free tier available):
GROQ_API_KEY=gsk_your_key_here
BACKBONE_MODEL=llama-3.3-70b-versatile
#
# Anthropic instead:
# ANTHROPIC_API_KEY=sk-ant-...
# BACKBONE_MODEL=claude-sonnet-5
#
# Optional: force a provider when both keys are present.
# BACKBONE_PROVIDER=groq
